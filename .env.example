# Copy to .env for local development. Never commit .env.

APP_ENV=local
APP_TIMEZONE=Africa/Harare

# Public address of the site with no trailing slash. Paynow sends customers and
# payment results back here, so in production it must be the real https address.
APP_URL=http://localhost:8000

# --- Database -------------------------------------------------------------
# Local development without a database server:
DB_DRIVER=sqlite

# Production (Aiven MySQL): remove DB_DRIVER above and set the service URI.
# DATABASE_URL=mysql://avnadmin:PASSWORD@HOST:PORT/defaultdb
# Path to the Aiven CA certificate (ca.pem). Recommended: verifies the server.
# DB_SSL_CA=/etc/secrets/aiven-ca.pem
# Only for a local MySQL without TLS:
# DB_SSL=off

# --- Admin ----------------------------------------------------------------
# Required in production to open /admin/setup.php?token=... the first time.
# ADMIN_SETUP_TOKEN=

# Set to 1 only behind a proxy you trust (Render), so the real visitor IP and
# https are read from the forwarded headers.
# TRUST_PROXY=1

# --- Paynow deposits ------------------------------------------------------
# From the Paynow merchant dashboard (Receive Payment Links > 3rd Party Site).
# Leave empty to keep online deposits switched off.
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
# While the Paynow integration is in test mode, this must be the merchant's
# own Paynow login email. Remove it once the integration is live.
PAYNOW_AUTH_EMAIL=
